      },
      "secure": [
        "password"
      ]
    },
    "tcb-jobs": {
      "type": "rse",
      "properties": {
        "port": 8195,
        "basePath": "rseapi",
        "protocol": "https",
        "encoding": "IBM-1047"
      },
      "secure": []
    }
