{
  "$schema": "./zowe.schema.json",
  "profiles": {
    "tcb-zosmf": {
      "type": "zosmf",
      "properties": {
        "port": 8192,
        "protocol": "https",
        "encoding": "IBM-937"
      },
      "secure": []
    },
    "tcb-base": {
      "type": "base",
      "properties": {
        "host": "165.192.134.122",
        "user": "YOUR_USER_ID",
        "rejectUnauthorized": false
      },
      "secure": [
        "password"
      ]
    },
    "tcb-jobs": {
      "type": "zosmf",
      "properties": {
        "port": 8192,
        "protocol": "https",
        "encoding": "IBM-1047"
      },
      "secure": []
    }
  },
  "defaults": {
    "zosmf": "tcb-zosmf",
    "base": "tcb-base"
  },
  "autoStore": true
}
