//TCBEVTS JOB (ACCT),'IMS EVENTS LAB',CLASS=A,MSGCLASS=H,
// MSGLEVEL=(1,1),NOTIFY=&SYSUID
//ALLOC EXEC PGM=IEFBR14
//LOAD DD DSN=&&LOAD,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1,10)),DSNTYPE=LIBRARY,DCB=(RECFM=U)
//DBD DD DSN=&&DBD,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1,10)),DSNTYPE=LIBRARY,DCB=(RECFM=U)
//PSB DD DSN=&&PSB,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1,10)),DSNTYPE=LIBRARY,DCB=(RECFM=U)
//A0 EXEC PGM=ASMA90,REGION=64M,PARM='OBJECT,NODECK',
// COND=(0,NE)
//SYSLIB DD DSN=IMS.V15R1M0.SDFSMAC,DISP=SHR
//SYSLIN DD DSN=&&OBJ0,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80)
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSIN DD *
         DBD NAME=TCBEVDB,ACCESS=(HDAM,OSAM),                          X
               RMNAME=(DFSHDC40,1,10,1000)
         DATASET DD1=EVTDB,SIZE=4096
         SEGM NAME=EVROOT,PARENT=0,BYTES=404
         FIELD NAME=(ROOTKEY,SEQ,U),BYTES=4,START=1,TYPE=C
         SEGM NAME=EVCHILD,PARENT=EVROOT,BYTES=20
         FIELD NAME=(CHILDKEY,SEQ,U),BYTES=4,START=1,TYPE=C
         DBDGEN
         FINISH
         END
/*
//B0 EXEC PGM=IEWL,PARM='LIST,XREF',COND=(0,NE,A0)
//SYSLIN DD DSN=&&OBJ0,DISP=(OLD,DELETE)
//SYSLMOD DD DSN=&&DBD(TCBEVDB),DISP=(OLD,PASS)
//SYSPRINT DD SYSOUT=*
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(TRK,(1,1))
//A1 EXEC PGM=ASMA90,REGION=64M,PARM='OBJECT,NODECK',
// COND=(0,NE)
//SYSLIB DD DSN=IMS.V15R1M0.SDFSMAC,DISP=SHR
//SYSLIN DD DSN=&&OBJ1,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80)
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSIN DD *
         PCB TYPE=DB,DBDNAME=TCBEVDB,PROCOPT=L,KEYLEN=8
         SENSEG NAME=EVROOT,PARENT=0
         SENSEG NAME=EVCHILD,PARENT=EVROOT
         PSBGEN LANG=COBOL,PSBNAME=TCBEVPL,CMPAT=YES
         END
/*
//B1 EXEC PGM=IEWL,PARM='LIST,XREF',COND=(0,NE,A1)
//SYSLIN DD DSN=&&OBJ1,DISP=(OLD,DELETE)
//SYSLMOD DD DSN=&&PSB(TCBEVPL),DISP=(OLD,PASS)
//SYSPRINT DD SYSOUT=*
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(TRK,(1,1))
//A2 EXEC PGM=ASMA90,REGION=64M,PARM='OBJECT,NODECK',
// COND=(0,NE)
//SYSLIB DD DSN=IMS.V15R1M0.SDFSMAC,DISP=SHR
//SYSLIN DD DSN=&&OBJ2,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80)
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSIN DD *
         PCB TYPE=DB,DBDNAME=TCBEVDB,PROCOPT=A,KEYLEN=8
         SENSEG NAME=EVROOT,PARENT=0
         SENSEG NAME=EVCHILD,PARENT=EVROOT
         PSBGEN LANG=COBOL,PSBNAME=TCBEVPU,CMPAT=YES
         END
/*
//B2 EXEC PGM=IEWL,PARM='LIST,XREF',COND=(0,NE,A2)
