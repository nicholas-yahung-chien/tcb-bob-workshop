// SPACE=(CYL,(1,1))
//SYSUT9 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT10 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT11 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT12 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT13 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT14 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT15 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSIN DD DSN=&SYSUID..TCBLAB.COBOL(IMSEVT),DISP=SHR
//LIMS EXEC PGM=IEWL,PARM='LIST,MAP,XREF',COND=(0,NE)
//SYSLIB DD DSN=CEE.SCEELKED,DISP=SHR
// DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
//SYSLIN DD DSN=&&IMSEVT,DISP=(OLD,DELETE)
// DD *
 ENTRY DLITCBL
/*
//SYSPRINT DD SYSOUT=*
//SYSUT1 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSLMOD DD DSN=&&LOAD(IMSEVT),DISP=(OLD,PASS)
//DBLOAD EXEC PGM=DFSRRC00,REGION=128M,COND=(0,NE),
// PARM=('DLI,IMSEVT,TCBEVPL,7,0000,,0,,N,0,T',
// ',,N,N,,Y')
//STEPLIB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
