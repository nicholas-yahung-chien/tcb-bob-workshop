// SPACE=(CYL,(1,1))
//SYSUT5 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT6 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1))
//SYSUT7 DD UNIT=3390,
// VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
