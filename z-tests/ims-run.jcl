//CHKFILE EXEC PGM=CHKCKP,REGION=64M,COND=(4,LT)
//STEPLIB DD DSN=&&LOAD,DISP=(OLD,PASS)
// DD DSN=CEE.SCEERUN,DISP=SHR
//ACTUALDD DD DSN=&&TRANSFER,DISP=(OLD,PASS)
//EXPECTDD DD DSN=&&EXP1,DISP=(OLD,PASS)
//BEFOREDD DD DSN=&&WORK,DISP=(OLD,PASS)
//SYSOUT DD SYSOUT=*
//ROLLBACK EXEC PGM=DFSRRC00,REGION=128M,COND=(4,LT),
// PARM=('DLI,IMSCKP,TCBCKPU,7,0000,,0,,N,0,T',
// ',,N,N,,Y')
//STEPLIB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
// DD DSN=&&LOAD,DISP=(OLD,PASS)
// DD DSN=CEE.SCEERUN,DISP=SHR
//DFSRESLB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
//IMS DD DSN=&&PSB,DISP=(OLD,PASS)
// DD DSN=&&DBD,DISP=(OLD,PASS)
//DFSVSAMP DD *
4096,20
/*
//PROCLIB DD DSN=IMS.V15R1M0.PROCLIB,DISP=SHR
//SYSOUT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CEEDUMP DD SYSOUT=*
//IEFRDER DD DSN=&&LROLLBAC,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1)),
// DCB=(RECFM=VB,LRECL=4092,BLKSIZE=4096)
//CKPDB DD DSN=&&IMSDB,DISP=(OLD,PASS)
//INPUT1 DD DSN=&&TRANSFER,DISP=(OLD,PASS)
//OUTPUT1 DD DUMMY
//SYSIN DD *
ROLLBACK
/*
//UPDATE EXEC PGM=DFSRRC00,REGION=128M,COND=(4,LT),
// PARM=('DLI,IMSCKP,TCBCKPU,7,0000,,0,,N,0,T',
// ',,N,N,,Y')
//STEPLIB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
// DD DSN=&&LOAD,DISP=(OLD,PASS)
// DD DSN=CEE.SCEERUN,DISP=SHR
//DFSRESLB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
//IMS DD DSN=&&PSB,DISP=(OLD,PASS)
// DD DSN=&&DBD,DISP=(OLD,PASS)
//DFSVSAMP DD *
4096,20
/*
//PROCLIB DD DSN=IMS.V15R1M0.PROCLIB,DISP=SHR
//SYSOUT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CEEDUMP DD SYSOUT=*
//IEFRDER DD DSN=&&LUPDATE,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1)),
// DCB=(RECFM=VB,LRECL=4092,BLKSIZE=4096)
//CKPDB DD DSN=&&IMSDB,DISP=(OLD,PASS)
//INPUT1 DD DSN=&&TRANSFER,DISP=(OLD,PASS)
//OUTPUT1 DD DUMMY
//SYSIN DD *
UPDATE
/*
//VERIFY EXEC PGM=DFSRRC00,REGION=128M,COND=(4,LT),
// PARM=('DLI,IMSCKP,TCBCKPU,7,0000,,0,,N,0,T',
// ',,N,N,,Y')
//STEPLIB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
// DD DSN=&&LOAD,DISP=(OLD,PASS)
// DD DSN=CEE.SCEERUN,DISP=SHR
//DFSRESLB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
//IMS DD DSN=&&PSB,DISP=(OLD,PASS)
// DD DSN=&&DBD,DISP=(OLD,PASS)
//DFSVSAMP DD *
4096,20
/*
//PROCLIB DD DSN=IMS.V15R1M0.PROCLIB,DISP=SHR
//SYSOUT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CEEDUMP DD SYSOUT=*
//IEFRDER DD DSN=&&LVERIFY,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1)),
// DCB=(RECFM=VB,LRECL=4092,BLKSIZE=4096)
//CKPDB DD DSN=&&IMSDB,DISP=(OLD,PASS)
//INPUT1 DD DSN=&&TRANSFER,DISP=(OLD,PASS)
//OUTPUT1 DD DUMMY
//SYSIN DD *
CHECK
/*
//PROLLBAC EXEC PGM=DFSERA10,COND=(4,LT)
//STEPLIB DD DSN=IMS.V15R1M0.SDFSRESL,DISP=SHR
//SYSUT1 DD DSN=&&LROLLBAC,DISP=(OLD,PASS)
//SYSPRINT DD SYSOUT=*
//SYSIN DD *
CONTROL  CNTL
OPTION   PRINT
END
/*
//PUPDATE EXEC PGM=DFSERA10,COND=(4,LT)
