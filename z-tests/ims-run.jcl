//TCBIMSP JOB (ACCT),'IMS CKP PILOT',CLASS=A,MSGCLASS=H,
// MSGLEVEL=(1,1),NOTIFY=&SYSUID
//ALLOC EXEC PGM=IEFBR14
//LOAD DD DSN=&&LOAD,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1,10)),DSNTYPE=LIBRARY,DCB=(RECFM=U)
//DBD DD DSN=&&DBD,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1,10)),DSNTYPE=LIBRARY,DCB=(RECFM=U)
//PSB DD DSN=&&PSB,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(CYL,(1,1,10)),DSNTYPE=LIBRARY,DCB=(RECFM=U)
//A0 EXEC PGM=ASMA90,REGION=64M,PARM='OBJECT,NODECK'
//SYSLIB DD DSN=IMS.V15R1M0.SDFSMAC,DISP=SHR
//SYSLIN DD DSN=&&OBJ0,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80)
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSIN DD *
         DBD NAME=TCBCKDB,ACCESS=(HDAM,OSAM),                          X
               RMNAME=(DFSHDC40,1,10,1000)
         DATASET DD1=CKPDB,SIZE=4096
         SEGM NAME=CKPROOT,PARENT=0,BYTES=404
         FIELD NAME=(CASEKEY,SEQ,U),BYTES=4,START=1,TYPE=C
         DBDGEN
         FINISH
         END
/*
//B0 EXEC PGM=IEWL,PARM='LIST,XREF',COND=(0,NE,A0)
//SYSLIN DD DSN=&&OBJ0,DISP=(OLD,DELETE)
//SYSLMOD DD DSN=&&DBD(TCBCKDB),DISP=(OLD,PASS)
//SYSPRINT DD SYSOUT=*
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(TRK,(1,1))
//A1 EXEC PGM=ASMA90,REGION=64M,PARM='OBJECT,NODECK'
//SYSLIB DD DSN=IMS.V15R1M0.SDFSMAC,DISP=SHR
//SYSLIN DD DSN=&&OBJ1,DISP=(NEW,PASS),
// UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,
// SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80)
//SYSUT1 DD UNIT=3390,VOL=SER=DEVVS1,STORCLAS=SCNOSMS,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSIN DD *
         PCB TYPE=DB,DBDNAME=TCBCKDB,PROCOPT=L,KEYLEN=4
         SENSEG NAME=CKPROOT,PARENT=0
         PSBGEN LANG=COBOL,PSBNAME=TCBCKPL,CMPAT=YES
         END
