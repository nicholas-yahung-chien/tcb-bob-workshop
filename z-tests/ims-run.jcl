//SYSPRINT DD SYSOUT=*
//SYSIN DD *
         PCB TYPE=DB,DBDNAME=TCBCKDB,PROCOPT=L,KEYLEN=4
         SENSEG NAME=CKPROOT,PARENT=0
         PSBGEN LANG=COBOL,PSBNAME=TCBCKPL,CMPAT=YES
         END
